#!/bin/sh
set -eu
launcher_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
jar="$launcher_dir/../target/pocketgit.jar"
if [ ! -f "$jar" ]; then
    printf '%s\n' 'error: build PocketGit first with mvn clean verify' >&2
    exit 1
fi
if [ -n "${JAVA_HOME:-}" ]; then
    exec "$JAVA_HOME/bin/java" -jar "$jar" "$@"
fi
exec java -jar "$jar" "$@"
