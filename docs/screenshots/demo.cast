{"version": 2, "width": 94, "height": 26, "timestamp": 1790754420, "title": "PocketGit: snapshots, branches, checkout, restore, verify", "command": "sh examples/demo.sh", "env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}}
[0.012399, "o", "PocketGit — snapshots, branches, and byte-exact restore\r\n\r\n$ pocketgit init\r\n"]
[0.671512, "o", "Initialized empty PocketGit repository in /tmp/pocketgit-demo.FswsFirC/.pocketgit\r\n"]
[1.385043, "o", "\r\n$ pocketgit config user.name \"PocketGit Demo\"\r\n"]
[2.649445, "o", "\r\n$ pocketgit config user.email \"demo@example.com\"\r\n"]
[3.999788, "o", "\r\n$ printf 'hello\\n' > hello.txt\r\n"]
[4.70237, "o", "\r\n$ pocketgit status\r\n"]
[5.174627, "o", "On branch main\r\nNo commits yet\r\n\r\nUntracked files:\r\n  hello.txt\r\n"]
[5.894075, "o", "\r\n$ pocketgit add .\r\n"]
[6.469351, "o", "Staged hello.txt\r\n"]
[7.189004, "o", "\r\n$ pocketgit commit -m \"Initial commit\"\r\n"]
[7.787088, "o", "[main 6984f35] Initial commit\r\n 1 files changed\r\n"]
[8.506035, "o", "\r\n$ printf 'world\\n' >> hello.txt\r\n"]
[9.209407, "o", "\r\n$ pocketgit status\r\n"]
[9.819394, "o", "On branch main\r\n\r\nChanges not staged:\r\n  modified:   hello.txt\r\n"]
[10.546083, "o", "\r\n$ pocketgit diff\r\n"]
[11.078428, "o", "diff --pocketgit a/hello.txt b/hello.txt\r\n--- a/hello.txt\r\n+++ b/hello.txt\r\n@@ -1,1 +1,2 @@\r\n hello\r\n+world\r\n"]
[11.788143, "o", "\r\n$ pocketgit add .\r\n"]
[12.428786, "o", "Staged hello.txt\r\n"]
[13.139258, "o", "\r\n$ pocketgit diff --staged\r\n"]
[13.806031, "o", "diff --pocketgit a/hello.txt b/hello.txt\r\n--- a/hello.txt\r\n+++ b/hello.txt\r\n@@ -1,1 +1,2 @@\r\n hello\r\n+world\r\n"]
[14.529439, "o", "\r\n$ pocketgit commit -m \"Update hello\"\r\n"]
[15.158007, "o", "[main b0c576c] Update hello\r\n 1 files changed\r\n"]
[15.867755, "o", "\r\n$ pocketgit branch experiment\r\n"]
[16.508042, "o", "Created branch 'experiment'.\r\n"]
[17.232617, "o", "\r\n$ pocketgit checkout experiment\r\n"]
[17.823374, "o", "Switched to branch 'experiment'\r\n"]
[18.538146, "o", "\r\n$ printf 'branch work\\n' > experiment.txt\r\n"]
[19.240777, "o", "\r\n$ pocketgit add .\r\n"]
[19.77216, "o", "Staged 2 files and 0 deletions.\r\n"]
[20.494849, "o", "\r\n$ pocketgit commit -m \"Experiment\"\r\n"]
[21.18534, "o", "[experiment 160d3a7] Experiment\r\n 1 files changed\r\n"]
[21.893708, "o", "\r\n$ pocketgit branch\r\n"]
[22.15899, "o", "* experiment\r\n  main\r\n"]
[22.868353, "o", "\r\n$ pocketgit log --oneline\r\n"]
[23.422434, "o", "160d3a7 Experiment\r\nb0c576c Update hello\r\n6984f35 Initial commit\r\n"]
[24.136556, "o", "\r\n$ pocketgit checkout main\r\n"]
[24.738121, "o", "Switched to branch 'main'\r\n"]
[25.447828, "o", "\r\n$ pocketgit log --oneline\r\n"]
[25.994646, "o", "b0c576c Update hello\r\n6984f35 Initial commit\r\n"]
[26.715984, "o", "\r\n$ pocketgit restore --commit 6984f3520221 hello.txt\r\n"]
[27.45409, "o", "Restored hello.txt\r\n"]
[28.172699, "o", "\r\n$ cat hello.txt\r\n"]
[28.174101, "o", "hello\r\n"]
[28.875538, "o", "\r\n$ pocketgit restore hello.txt\r\n"]
[29.678008, "o", "Restored hello.txt\r\n"]
[30.402676, "o", "\r\n$ pocketgit status\r\n"]
[31.406577, "o", "On branch main\r\nnothing to commit, working tree clean\r\n"]
[32.129973, "o", "\r\n$ pocketgit verify\r\n"]
[33.119136, "o", "Checking repository...\r\n✓ HEAD\r\n✓ refs\r\n✓ commits\r\n✓ trees\r\n✓ blobs\r\n✓ index\r\n"]
[33.119844, "o", "Repository OK. (9 objects: 3 commits, 3 trees, 3 blobs)\r\n"]
[33.846552, "o", "\r\nDemo completed; repository preserved at /tmp/pocketgit-demo.FswsFirC\r\n"]
